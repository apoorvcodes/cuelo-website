---
import '../styles/global.css';

// One place for the site's identity. The domain comes from `site` in
// astro.config.mjs; keep public/robots.txt's Sitemap line in step with it.
const SITE = {
	name: 'Cuelo',
	github: 'https://github.com/apoorvcodes/cuelo',
	title: 'Cuelo · Open-source infrastructure for speech-to-speech systems',
	description:
		'Open-source infrastructure for speech-to-speech systems. Wire speech, LLM and tool models in config.cuelo, serve an OpenAI Realtime API, trace every turn.',
	imageAlt: 'cuelo. logo beside a grey stippled garden with a window of blue flowers, and a speech waveform made of numbers drifting across it',
};

interface Props {
	title?: string;
	description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;

const site = Astro.site ?? new URL('https://cuelo.dev');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;

// Structured data: who makes it, the site, and the software itself
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${site.href}#org`,
			name: SITE.name,
			url: site.href,
			logo: new URL('/apple-touch-icon.png', site).href,
			sameAs: [SITE.github],
		},
		{
			'@type': 'WebSite',
			'@id': `${site.href}#website`,
			name: SITE.name,
			url: site.href,
			description: SITE.description,
			publisher: { '@id': `${site.href}#org` },
			inLanguage: 'en',
		},
		{
			'@type': 'SoftwareApplication',
			'@id': `${site.href}#software`,
			name: SITE.name,
			url: site.href,
			description:
				'An open-source framework and harness for building, running and debugging speech-to-speech systems. Wire speech-to-text, LLM, text-to-speech and action models into one pipeline with config.cuelo, serve it behind an OpenAI Realtime-compatible API, and trace audio, transcripts, turn-taking and latency on every turn.',
			applicationCategory: 'DeveloperApplication',
			applicationSubCategory: 'Voice AI infrastructure',
			operatingSystem: 'macOS, Linux, Windows',
			isAccessibleForFree: true,
			offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
			image: ogImage,
			sameAs: [SITE.github],
			publisher: { '@id': `${site.href}#org` },
			keywords: 'speech-to-speech, voice agents, voice AI, realtime API, OpenAI Realtime compatible, speech-to-text, text-to-speech, turn detection, endpointing, barge-in, voice pipeline, MCP, open source',
			featureList: [
				'Declarative pipelines in config.cuelo',
				'Any speech-to-text, LLM and text-to-speech provider, or one speech-to-speech model',
				'OpenAI Realtime-compatible or custom API endpoints',
				'SDKs for TypeScript, Python and Go',
				'Per-turn tracing: TTFB, VAD, turn detection, tool calls',
				'SQLite by default; Postgres, MySQL or a custom store',
				'MCP server for Claude Code, Codex and other coding agents',
			],
		},
		{
			'@type': 'SoftwareSourceCode',
			'@id': `${site.href}#code`,
			name: SITE.name,
			codeRepository: SITE.github,
			url: SITE.github,
			programmingLanguage: ['TypeScript', 'Python', 'Go'],
			targetProduct: { '@id': `${site.href}#software` },
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="theme-color" content="#F4F2EE" />
		<meta name="color-scheme" content="light" />
		<meta name="generator" content={Astro.generator} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..600&display=swap" rel="stylesheet" />

		<!-- social previews -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={SITE.imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={SITE.imageAlt} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<slot />
	</body>
</html>
